{
  "$schema": "https://github.com/anthropics/claude-code/blob/main/docs/hooks.md",
  "_说明": [
    "把 hooks 里的内容合入 ~/.claude/settings.json(全局)或 <项目>/.claude/settings.json(单项目)。",
    "改完必须**新开一个 Claude Code 会话**才生效。",
    "$CLAUDE_PROJECT_DIR 由 Claude Code 在拉起 hook 时注入,只在该仓库内跑 Claude Code 时可用;",
    "若你把脚本装在仓库外,换成绝对路径。",
    "**这里的引号是必需的,不要删。** Claude Code 用 bash 执行 hook 命令,路径带空格时必须引号;",
    "timeout=3 秒 + async:true:上报慢一点也绝不拖住 Agent(铁律 1)。",
    "matcher 用 \"*\" 而不是枚举工具名:枚举表会漏掉 MultiEdit / NotebookEdit / WebFetch 等,",
    "漏一个工具就等于那类改动永远进不了门控 —— 分类归一化在脚本里做,不在配置里做。"
  ],
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/adapters/claude-code-hook/kvba-claude-hook.mjs\"",
            "timeout": 3,
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/adapters/claude-code-hook/kvba-claude-hook.mjs\"",
            "timeout": 3,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/adapters/claude-code-hook/kvba-claude-hook.mjs\"",
            "timeout": 3,
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/adapters/claude-code-hook/kvba-claude-hook.mjs\"",
            "timeout": 3,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/adapters/claude-code-hook/kvba-claude-hook.mjs\"",
            "timeout": 3,
            "async": true
          }
        ]
      }
    ]
  }
}
